# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose service "db")
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=complaints
DATABASE_URL=postgresql://triage:change-me-locally@localhost:5432/complaints

# Ollama (runs on the host machine)
# From inside a Docker container on Windows/macOS use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Dataset sampling
SAMPLE_SIZE=5000
RANDOM_SEED=42
